# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Demonstration Mode (Set to true to use rich Dibrugarh mock data when Supabase is unconfigured)
VITE_USE_DEMO_DATA=true

# India Meteorological Department (IMD) API - Server-side only (no VITE_ prefix to prevent client exposure)
IMD_API_URL=https://api.imd.gov.in/api/v1/districtrainfall
IMD_WX_API_URL=https://api.imd.gov.in/api/v1/current_wx
IMD_STATION_ID=42410
IMD_NOWCAST_API_URL=https://api.imd.gov.in/api/v1/districtnowcast
IMD_NOWCAST_DISTRICT_ID=310
IMD_API_KEY=your-imd-api-key-here
IMD_AUTH_TOKEN=your-imd-jwt-token-here


